rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// A&M Clean — Firestore security rules
//
// Shared by the web app (A-M-Clean-web) and the mobile app (smartclean3).
// KEEP THE TWO COPIES IDENTICAL — whichever project deploys last wins, so a
// divergence silently reverts the other side's protections.
//
// Design notes:
//  • "Signed in" is NOT an authorization decision. Every collection below is
//    scoped to the documents the caller actually participates in.
//  • Chat access is derived from the doc id (`uidA_uidB`, sorted) rather than a
//    lookup, so it costs no extra read and works for the messages sub-collection.
//  • A cleaner's free/busy time lives on their own user doc (`busySlots` /
//    `pendingSlots`) precisely so nobody needs to read other people's bookings
//    to check availability.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // `.get('email', '')` rather than `.email`: an anonymous or phone-auth token
    // has no email claim, and reading a missing property raises an evaluation
    // error. The clause still denies, but it denies noisily — the emulator logs
    // an exception on every such request, which buries real failures.
    // The caller's stored role. Nothing checked it on either claim branch, so a
    // client account claimed jobs off the open board and claimed open urgent
    // requests — and simply holding one takes it off every cleaner's board.
    // Costs one document read per claim, which is rare; discovery and reads do
    // not pay it.
    function callerIsCleaner() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.get('role', '') == 'cleaner';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('email', '') in [
        'cleantouchapp@gmail.com',
        'itzikofek669@gmail.com'
      ];
    }

    // Which top-level keys is this write touching?
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A rating write from a reviewer: only the aggregate fields, only plausible
    // values, and the counter may only move forward. Without the value checks a
    // signed-in stranger could zero out any cleaner's reputation.
    // The review count this document already carries, whichever of the three
    // spellings it is stored under.
    //
    // Reading only `reviewCount` made every bound below evaluate at n = 0 on any
    // profile that stores the count as `reviewsCount` or `reviews` — and the web
    // demo generator writes exactly that shape. With n = 0 the whole average
    // guard collapses to `0 <= new <= 5.01`, so one write set any such cleaner
    // to 0 stars or 5 while leaving the displayed count untouched. It is the
    // same attack the comments below say was closed, surviving under a
    // different field name.
    // The booking a rating write cites: it must exist, be finished, and be the
    // job these two people actually did together.
    function requestNamesAFinishedJob(cleanerUid) {
      return request.resource.data.get('ratedBooking', '') is string
        && request.resource.data.get('ratedBooking', '') != ''
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.ratedBooking))
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.ratedBooking)).data.get('status', '') == 'done'
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.ratedBooking)).data.get('clientUid', '') == uid()
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.ratedBooking)).data.get('cleanerId', '') == cleanerUid;
    }

    function priorReviewCount() {
      return resource.data.get('reviewCount',
             resource.data.get('reviewsCount',
             resource.data.get('reviews', 0)));
    }

    function isValidRatingUpdate(subjectUid) {
      return changed().hasOnly(['rating', 'reviewCount', 'reviews', 'reviewsCount', 'ratedBooking'])
        // Every rating movement must name a real, finished job between these two
        // people, and a different one each time.
        //
        // The per-write bound below is sound — 4.8 with 50 reviews can only move
        // to 4.7057 in one step — but nothing bounded the NUMBER of writes. One
        // ordinary account, no review documents at all: 25 writes took a 4.8 to
        // exactly 3.2 (which is the incident that was reported), and 200 writes
        // took it to 0.96 over a claimed 250 reviews. Upward too. Rate limiting
        // is not expressible here and does not need to be — a rating change that
        // must cite a distinct completed booking cannot be repeated.
        && requestNamesAFinishedJob(subjectUid)
        && request.resource.data.ratedBooking != resource.data.get('ratedBooking', '')
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.reviewCount is int
        // Exactly one more review than before. `> 0 && <= existing + 1` let the
        // counter move BACKWARDS: against a cleaner with 57 reviews the write
        // {rating: 0, reviewCount: 1} satisfied every clause, so any signed-in
        // stranger could erase a reputation in one request. The test that was
        // supposed to catch this passed only because it happened to send
        // reviewCount: 0, which tripped the `> 0` check instead.
        && request.resource.data.reviewCount == priorReviewCount() + 1
        // And the average may only move as far as ONE review can move it.
        //
        // Fixing the counter alone left the exploit working with one digit
        // changed: {rating: 0, reviewCount: existing + 1} passed every clause
        // and erased a reputation in a single request. With n existing reviews
        // and a new score in 0..5, the new average must satisfy
        //     old*n <= new*(n+1) <= old*n + 5
        // which is the whole of what a single honest review can do. Written as
        // multiplication rather than division to keep it exact, with a small
        // tolerance for the float rounding a client's own arithmetic produces.
        && request.resource.data.rating * (priorReviewCount() + 1)
             >= resource.data.get('rating', 0) * priorReviewCount() - 0.01
        && request.resource.data.rating * (priorReviewCount() + 1)
             <= resource.data.get('rating', 0) * priorReviewCount() + 5 + 0.01
        // The other two spellings are written alongside and were allowed by the
        // hasOnly list with no validation at all, so a stranger could park an
        // arbitrary object of any size on someone else's document.
        // Validated only when actually written — the mobile app sends `reviews`
        // and the web `reviewsCount`, and neither sends both. Requiring them
        // unconditionally would have rejected every real review.
        && (!changed().hasAny(['reviews'])
            || (request.resource.data.reviews is int
                && request.resource.data.reviews == request.resource.data.reviewCount))
        && (!changed().hasAny(['reviewsCount'])
            || (request.resource.data.reviewsCount is int
                && request.resource.data.reviewsCount == request.resource.data.reviewCount));
    }

    // Reputation may not be self-awarded. `uid() == userId` permits the owner to
    // write their own document, and nothing excluded the aggregate — so a
    // cleaner could simply set {rating: 5, reviewCount: 999} on themselves.
    function touchesOwnRating() {
      return changed().hasAny(['rating', 'reviewCount', 'reviews', 'reviewsCount']);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Profiles stay readable to signed-in users: cleaner discovery, chat names
    // and availability all depend on it. Writes are locked to the owner, with
    // one narrow exception for the review aggregate.
    match /users/{userId} {
      // `get` and `list` are split on purpose, and the split is the whole point.
      //
      // A single `allow read: if signedIn()` meant one ordinary account could
      // call getDocs(collection('users')) and walk off with the entire customer
      // table: every email, phone, saved home address, push token and private
      // adminNote in the product. Nothing needs that.
      //
      // A single-document `get` does still have real callers — chat and support
      // resolve a counterparty's display name by uid, and the two parties to a
      // booking are not otherwise related — so it stays open to signed-in users.
      // Enumeration is what is being closed here, not lookup.
      //
      // `list` is restricted to cleaner documents, which is exactly the shape
      // discovery already queries (where('role','==','cleaner')), so no screen
      // changes. A query that could return a client document is now refused.
      //
      // Still on the list after this: a cleaner's phone and email sit on a
      // publicly listable profile. Moving them behind an accepted booking is the
      // next step and needs a schema change, not a rule change.
      allow get: if signedIn();
      allow list: if isAdmin()
        || (signedIn() && resource.data.get('role', '') == 'cleaner');

      // `create` was pinned to the caller and nothing else, so a new account
      // could hand itself a 5.0 rating with 999 reviews, mark itself identity-
      // and email-verified, and — worst — write `blocked: false`. A banned
      // account unbanned itself in one write and erased the admin's note about
      // why. All the isValidRatingUpdate machinery was bypassed simply by
      // creating the document instead of updating it.
      allow create: if signedIn() && uid() == userId
        && !request.resource.data.keys().hasAny([
          'rating', 'reviewCount', 'reviews', 'reviewsCount',
          'blocked', 'blockedUntilReview', 'identityVerified', 'adminNote'
        ]);

      allow update: if isAdmin()
        || (signedIn() && uid() == userId && !touchesOwnRating()
            // Moderation state is the admin's, not the subject's. The role field is
            // here because it is not moderation but it is just as much theirs:
            // a client account wrote itself role 'cleaner' and appeared in
            // cleaner discovery, and role 'admin' passed the website's route
            // guard, which reads profile.role straight through.
            && !changed().hasAny(['blocked', 'blockedUntilReview', 'identityVerified', 'adminNote', 'role']))
        || (signedIn() && uid() != userId && isValidRatingUpdate(userId));

      allow delete: if isAdmin();

      // Reviews: anyone signed in may leave one; nobody may edit or delete it
      // afterwards (admins moderate by deleting the whole user).
      match /reviews/{reviewId} {
        allow read: if signedIn();
        // Not about yourself. Nothing checked this, so a cleaner wrote her own
        // five-star reviews — twenty in a loop in one probe. The numeric average
        // is safe (the aggregate branch refuses a self-write), but the visible
        // review list was fully forgeable.
        //
        // The text cap is here because nothing bounded it: a 400 KB review was
        // accepted, and every reader downloads it.
        allow create: if signedIn()
          && userId != uid()
          && request.resource.data.authorId == uid()
          && request.resource.data.get('text', '').size() <= 2000
          && request.resource.data.stars is number
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow update, delete: if isAdmin();
      }
    }

    // ── Profile photos ───────────────────────────────────────────────────────
    // One document per user, holding nothing but the avatar.
    //
    // It is split out of the user document on purpose: Firestore's client SDKs
    // cannot fetch a subset of fields, so an inline photo is downloaded by
    // every query that touches the profile — including the cleaner list, which
    // reads hundreds of documents to draw names and prices. Kept here, a photo
    // is only ever fetched for a face actually on screen.
    //
    // Readable by any signed-in user: the same audience that can already read
    // the profile it belongs to. Writable only by its owner, and size-capped —
    // without the cap this is an open 1 MiB-per-write file host for anyone with
    // an account.
    match /userPhotos/{userId} {
      // 250 K characters. The web compressor targets 120 K (AVATAR_PRESET in
      // src/lib/imageCompress.ts) and the mobile one accepts up to ~200 K, so
      // this clears both with room to spare while staying a quarter of a
      // document. Mirrored as MAX_AVATAR_CHARS in smartclean3/lib/photos.ts —
      // change the two together, or the app rejects a photo the rules would
      // have taken, or worse, the reverse.
      function isPhoto() {
        return request.resource.data.keys().hasOnly(['dataUrl', 'updatedAt'])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 250000
          && request.resource.data.dataUrl.matches('data:image/.*');
      }

      // `get`, not `list`. The document IDs here ARE user uids, so listing this
      // collection enumerated every account in the product — and `/users/{uid}`
      // is readable one at a time, so an attacker walked the uid list straight
      // back to the customer table the users `list` rule refuses to hand over:
      // email, phone, saved addresses, push token, private adminNote. Closing
      // the front door mattered less than this side one.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid() == userId && isPhoto();
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    // A cleaner's "my work" gallery. Split out of the user document for the
    // same reason as userPhotos: the cleaner list reads every cleaner doc, and
    // an inline array of base64 images meant browsing downloaded all of them.
    match /userPortfolios/{userId} {
      // What can be enforced here: the shape, and at most 12 images. Mirrored
      // as MAX_PORTFOLIO_IMAGES in src/lib/portfolio.ts and the app's copy.
      //
      // What CANNOT: per-image content or size. Rules have no way to iterate a
      // list, so there is no expression that checks every element is a
      // `data:image/...` string under the cap. Those two checks live in the
      // clients (`clean()` in portfolio.ts), and Firestore's own 1 MiB document
      // limit is the real backstop — a caller stuffing 12 huge strings in here
      // gets rejected by the write itself, not by this rule.
      //
      // Stated plainly because a rule that looks like validation and isn't is
      // worse than none: it invites trusting the data downstream.
      function isGallery() {
        return request.resource.data.keys().hasOnly(['images', 'updatedAt'])
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 12;
      }

      // `get`, not `list`. The document IDs here ARE user uids, so listing this
      // collection enumerated every account in the product — and `/users/{uid}`
      // is readable one at a time, so an attacker walked the uid list straight
      // back to the customer table the users `list` rule refuses to hand over:
      // email, phone, saved addresses, push token, private adminNote. Closing
      // the front door mattered less than this side one.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid() == userId && isGallery();
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    // ── Bookings ─────────────────────────────────────────────────────────────
    // A booking carries the client's full address, floor, flat and phone. Only
    // the two parties (and admin) may read it — plus open, unassigned jobs,
    // which are the public job board by definition.
    match /bookings/{bookingId} {
      function isParty() {
        return signedIn() && (
          resource.data.get('clientUid', '') == uid()
          || resource.data.get('cleanerId', '') == uid()
        );
      }
      function isOpenJob() {
        return signedIn()
          && resource.data.get('open', false) == true
          && resource.data.get('status', '') == 'pending';
      }

      // A cancelled booking stops being the cleaner's business. `isParty` kept
      // whoever was on it reading the client's street, floor, flat and phone
      // forever — and since a cancelled record is settled, no branch can clear
      // `cleanerId` to undo it. The client and admins keep full access.
      allow read: if isAdmin()
        || isTheClient()
        || (signedIn() && resource.data.get('cleanerId', '') == uid()
            && resource.data.get('status', '') != 'cancelled')
        || isOpenJob();

      // The creator must own the booking they are creating — and a booking is
      // only ever born pending.
      //
      // Only `clientUid` was checked, so a client fabricated a finished, paid,
      // 99999 booking naming a cleaner who never worked for them: it lands in
      // that cleaner's dashboard feed and in the CRM's revenue figure. A
      // negative total was accepted too. Every legitimate creator in both
      // products writes `pending` (bookings.ts, app/home.tsx, the urgent claim),
      // and the settlement fields belong to the closing write, which has its
      // own branch and its own cap.
      allow create: if signedIn()
        && request.resource.data.get('clientUid', '') == uid()
        && request.resource.data.get('status', '') in ['pending', 'confirmed']
        && request.resource.data.get('total', 0) >= 0
        && !request.resource.data.keys().hasAny([
          'actualTotal', 'actualHours', 'paidAt', 'finishedAt', 'cleanerRating'
        ])

      // A cleaner creating the booking that an urgent claim produces.
      //
      // The clause above requires clientUid == uid(), and this write comes from
      // the CLEANER's session inside the claim transaction — so the urgent route
      // was denied outright, on both products, with the app showing a generic
      // error and the website a failed claim. Nothing caught it because the
      // suite had no positive case for it, the same gap that let the users
      // create rule refuse every cleaner registration.
      //
      // The urgent request itself is the authority: it must exist, still be
      // open, and name the same client. Rules see the pre-transaction state, so
      // the request is still 'open' here even though the same transaction is
      // about to mark it taken.
      || (signedIn()
          && request.resource.data.get('cleanerId', '') == uid()
          && request.resource.data.get('origin', '') == 'urgent'
          && request.resource.data.get('status', '') in ['pending', 'confirmed']
          && request.resource.data.get('total', 0) >= 0
          && !request.resource.data.keys().hasAny([
            'actualTotal', 'actualHours', 'paidAt', 'finishedAt', 'cleanerRating'
          ])
          && request.resource.data.keys().hasAll(['urgentRequestId'])
          && exists(/databases/$(database)/documents/urgentRequests/$(request.resource.data.urgentRequestId))
          && get(/databases/$(database)/documents/urgentRequests/$(request.resource.data.urgentRequestId)).data.get('status', '') == 'open'
          && get(/databases/$(database)/documents/urgentRequests/$(request.resource.data.urgentRequestId)).data.get('clientUid', '') == request.resource.data.get('clientUid', ''));

      // Who may write was already scoped here; WHAT they may write was not, and
      // that is the whole of the gap. A claimer could take an open job and set
      // `total: 0` in the same write, then — now a party — set `clientUid` to
      // themselves and `paymentStatus: 'paid'`, keeping permanent read access to
      // a record holding the client's address, floor, flat number and name.
      //
      // The money is fixed when the booking is created. Finishing a job records
      // what actually happened under `actualHours` / `actualTotal` (see endJob),
      // so no legitimate flow rewrites these.
      function bookingMoneyUnchanged() {
        return request.resource.data.get('total', 0) == resource.data.get('total', 0)
          && request.resource.data.get('price', 0) == resource.data.get('price', 0)
          && request.resource.data.get('pricePerHour', 0) == resource.data.get('pricePerHour', 0);
      }
      // The client never changes. The cleaner is set once, by the claim below.
      function bookingClientUnchanged() {
        return request.resource.data.get('clientUid', '')
            == resource.data.get('clientUid', '');
      }
      function bookingCleanerUnchanged() {
        return request.resource.data.get('cleanerId', '')
            == resource.data.get('cleanerId', '');
      }

      // What is actually billed and what is marked paid.
      //
      // Freezing `total`/`price`/`pricePerHour` missed the fields the product
      // reads: every display and payment path takes `actualTotal ?? total`, and
      // `paymentStatus` is what says the money arrived. A client could write
      // {actualTotal: 0, actualHours: 0, paymentStatus: 'paid'} on a finished
      // job and take a free cleaning, with the cleaner's earnings dropping to
      // match. Both are the cleaner's to record — endJob and "payment received"
      // are cleaner actions in both products — so only the cleaner may.
      function bookingSettlementByCleaner() {
        return !changed().hasAny(['actualTotal', 'actualHours', 'paymentStatus', 'paidAt', 'finishedAt'])
          || resource.data.get('cleanerId', '') == uid();
      }
      // What may be billed. The cleaner could write any figure at any time on a
      // record the client can no longer contest — 99999 for a 250 job after it
      // was closed and paid, or 5000 for a job that was cancelled and never
      // happened. A cancelled job is never billable, and a finished one is
      // capped at twice its agreed price, which covers honest overruns.
      function billingIsPlausible() {
        return !changed().hasAny(['actualTotal', 'actualHours', 'paymentStatus', 'paidAt'])
          || (resource.data.get('status', '') != 'cancelled'
              && request.resource.data.get('actualTotal', 0) >= 0
              && request.resource.data.get('actualTotal', 0)
                 <= resource.data.get('total', 0) * 2 + 100);
      }
      // A claim is four fields, in both products (cleanerActions.ts,
      // app/home.tsx). Without an allowlist the same write could rewrite the
      // service address and mark the job paid while claiming it.
      // Six fields, not four. claimUpdate also writes the busy window it derives
      // (lib/bookingActions), and a four-field allowlist DENIED every real claim
      // while the rules test — which sent only the four — passed. The feature was
      // completely broken and the suite said it was fine.
      function onlyClaimsTheJob() {
        return changed().hasOnly([
          'cleanerId', 'cleanerName', 'open', 'status', 'busyFrom', 'busyUntil'
        ]);
      }

      // Either party may progress the job (accept / cancel / complete), and an
      // unassigned open job may be claimed by any cleaner. Nobody else.
      // Putting a claimed board job back where it came from.
      //
      // Claiming a posted job now leaves it `pending` so the cleaner still has
      // to approve it, and rejecting it releases it rather than cancelling it —
      // the job belongs to the client, and one cleaner changing their mind must
      // not force them to post it again. That write clears `cleanerId`, which
      // the isParty branch forbids and the claim branch cannot reach (the job is
      // no longer `open`), so without this the reject button was denied every
      // time. Narrow on purpose: the holder only, a board job only, and only
      // back to exactly unclaimed-open-pending.
      // `origin` decides whether a rejection releases a job to the public board or
      // cancels it. Nothing may change it after creation: an adversarial probe
      // stamped `origin: 'open'` onto a DIRECT booking through the isParty
      // branch and then released it, which stripped the cleaner off it, put a
      // private booking on the public board, and handed the client's name,
      // street, floor, flat and PHONE to every signed-in account through
      // isOpenJob()'s read grant.
      function bookingOriginUnchanged() {
        return request.resource.data.get('origin', '') == resource.data.get('origin', '');
      }
      // Only the release branch below may put a booking back on the board. The
      // same probe reopened a finished, PAID job this way — `paymentStatus`,
      // `actualTotal` and the address all readable by strangers.
      function bookingBoardStateUnchanged() {
        return request.resource.data.get('open', false) == resource.data.get('open', false);
      }
      // A finished or cancelled booking is a record, not a live job. Only the
      // review fields may still be written to it — a client was able to rewrite
      // the address on a settled booking.
      // Where the cleaner is sent, and who they are meeting. A probe claimed a
      // board job, rewrote the address, phone, date and time, then released it —
      // every cleaner who took it afterwards was directed to an address of the
      // attacker's choosing, and the doctored record was world-readable through
      // isOpenJob(). Freezing `origin` did not help because none of this touches
      // it. The client may still correct their own details; the cleaner may not.
      function bookingClientDataUnchanged() {
        return request.resource.data.get('address', '') == resource.data.get('address', '')
          && request.resource.data.get('addrStreet', '') == resource.data.get('addrStreet', '')
          && request.resource.data.get('addrCity', '') == resource.data.get('addrCity', '')
          && request.resource.data.get('addrFloor', '') == resource.data.get('addrFloor', '')
          && request.resource.data.get('addrApt', '') == resource.data.get('addrApt', '')
          && request.resource.data.get('phone', '') == resource.data.get('phone', '')
          && request.resource.data.get('clientName', '') == resource.data.get('clientName', '')
          && request.resource.data.get('bookingDate', '') == resource.data.get('bookingDate', '')
          && request.resource.data.get('startTime', '') == resource.data.get('startTime', '')
          // What was agreed, not just where. A probe on a live booking rewrote
          // hours to 12, replaced the service, wiped the client's notes, changed
          // the payment method and renamed the cleaner on the record — the live
          // branch is a blocklist, so everything it does not name is writable.
          && request.resource.data.get('hours', 0) == resource.data.get('hours', 0)
          && request.resource.data.get('serviceType', '') == resource.data.get('serviceType', '')
          && request.resource.data.get('serviceTypes', []) == resource.data.get('serviceTypes', [])
          && request.resource.data.get('notes', '') == resource.data.get('notes', '')
          && request.resource.data.get('payment', '') == resource.data.get('payment', '')
          && request.resource.data.get('isPrivateHouse', false) == resource.data.get('isPrivateHouse', false)
          && request.resource.data.get('cleanerName', '') == resource.data.get('cleanerName', '')
          // The review prompt and the score are the client's. A cleaner turned
          // reviewRequired off on her own job and the prompt never appeared.
          && request.resource.data.get('reviewRequired', true) == resource.data.get('reviewRequired', true)
          && request.resource.data.get('cleanerRating', 0) == resource.data.get('cleanerRating', 0);
      }

      // A score on the booking itself, written by the client at review time.
      // Unbounded, a probe wrote 999 — it feeds nothing today, but it is the
      // number a future payout or ranking would read.
      function bookingRatingInRange() {
        return !changed().hasAny(['cleanerRating'])
          || (request.resource.data.cleanerRating is number
              && request.resource.data.cleanerRating >= 1
              && request.resource.data.cleanerRating <= 5);
      }
      function isTheClient() {
        return signedIn() && resource.data.get('clientUid', '') == uid();
      }
      // A cleaner walking away from a job the client posted must put it BACK,
      // not destroy it. Otherwise any account claims every job on the board and
      // cancels them one by one, and the client cannot revive their own.
      function cleanerIsNotDestroyingABoardJob() {
        // Every terminal status, not just 'cancelled'. The guard named one word,
        // so the same job was killed with { status: 'expired' } instead — and
        // the client's attempt to revive it was then refused. bookingIsSettled()
        // already treats all three as terminal; this has to agree with it.
        return !(resource.data.get('origin', '') == 'open'
                 && resource.data.get('status', '') == 'pending'
                 && !isTheClient()
                 && request.resource.data.get('status', '')
                    in ['cancelled', 'expired', 'handled']);
      }

      function bookingIsSettled() {
        // Every terminal status, not just two. `expired` and `handled` are
        // written elsewhere in the product and were leaving an ended job fully
        // rewritable through the party branch.
        return resource.data.get('status', '')
          in ['done', 'cancelled', 'expired', 'handled'];
      }
      // What may still be written once the job is over: the reviews, and the
      // settlement the cleaner records afterwards — markPaid writes
      // `paymentStatus` on a booking that is already `done`.
      function onlyAfterTheJobFields() {
        return changed().hasOnly([
          'cleanerRating', 'clientRating', 'reviewRequired', 'reviewDeadline', 'autoClosed',
          'actualTotal', 'actualHours', 'paymentStatus', 'paidAt', 'finishedAt'
        ]);
      }

      function releasesBoardJob() {
        return signedIn()
          && resource.data.get('cleanerId', '') == uid()
          && resource.data.get('origin', '') == 'open'
          // WHERE IT STARTS FROM, not only where it lands. Without these two the
          // rule described the destination and nothing else, so a review proved
          // a finished-and-paid job could be flung back onto the public board:
          // the completed record became an advert, another cleaner would turn up
          // for work already done, and `paymentStatus: 'paid'` rode along
          // untouched. Worse, isOpenJob() grants `read` to any signed-in account
          // for an open pending booking — so the released record leaked the
          // client's address, floor, flat and name to everyone. A cancelled
          // booking came back to life the same way.
          && resource.data.get('status', '') == 'pending'
          && resource.data.get('open', false) == false
          && changed().hasOnly([
            'cleanerId', 'cleanerName', 'open', 'status', 'releasedAt', 'busyFrom', 'busyUntil'
          ])
          && request.resource.data.get('cleanerId', '') == ''
          && request.resource.data.get('open', false) == true
          && request.resource.data.get('status', '') == 'pending';
      }

      // Either party may progress the job (accept / cancel / complete), an
      // unassigned open job may be claimed by any cleaner, and whoever claimed
      // one off the board may put it back. Nobody else.
      allow update: if isAdmin()
        // Either party progressing a live job.
        || (isParty() && !bookingIsSettled()
            && bookingClientUnchanged() && bookingCleanerUnchanged()
            && bookingMoneyUnchanged() && bookingSettlementByCleaner()
            && bookingOriginUnchanged() && bookingBoardStateUnchanged()
            && (isTheClient() || bookingClientDataUnchanged())
            // The closing write is on THIS branch, not the settled one:
            // bookingIsSettled() reads the state BEFORE the write, so a cleaner
            // moving a live job to 'done' was never checked against the cap. A
            // probe billed 99999 on a 300 job in one write, and the identical
            // figure sent after the job was already done is refused.
            && billingIsPlausible()
            && bookingRatingInRange()
            && cleanerIsNotDestroyingABoardJob())
        // Rating and settling a job that is already over.
        || (isParty() && bookingIsSettled() && onlyAfterTheJobFields()
            && bookingSettlementByCleaner() && billingIsPlausible()
            && bookingRatingInRange())
        // A cleaner claiming an unheld job off the board. The destination is
        // pinned: a probe claimed one straight to `done`, and another claimed a
        // job somebody else was already holding, because neither the resulting
        // status nor the current cleanerId was checked.
        || (isOpenJob() && callerIsCleaner()
            && bookingClientUnchanged() && bookingMoneyUnchanged()
            && bookingOriginUnchanged()
            && resource.data.get('cleanerId', '') == ''
            && onlyClaimsTheJob()
            && request.resource.data.get('cleanerId', '') == uid()
            && request.resource.data.get('status', '') == 'pending'
            && request.resource.data.get('open', false) == false)
        // The holder putting a board job back.
        || (releasesBoardJob() && bookingClientUnchanged() && bookingMoneyUnchanged());

      // Bookings are financial records — cancel, never delete.
      allow delete: if false;
    }

    // ── Chats ────────────────────────────────────────────────────────────────
    // The doc id is the two participant uids, sorted and joined with "_".
    // Firebase uids contain no underscores, so splitting is unambiguous.
    match /chats/{chatId} {
      // Membership two ways, and the distinction matters.
      //
      // `inChatId` reads the document ID, which is the two uids sorted and
      // joined with "_". That works for a direct get and for writes, where the
      // document may not exist yet.
      //
      // It does NOT work for a QUERY. The conversations list asks for
      // `where('participants','array-contains',me)`, and Firestore will only
      // run a query it can prove returns nothing unreadable — it compares the
      // query's filters against the rule. A rule phrased in terms of the
      // document ID has nothing to compare against an array-contains filter on
      // a field, so the whole listener was rejected with permission-denied.
      // Every signed-in user hit this on every screen; the conversations list
      // has never loaded.
      //
      // `isParticipant` is written in exactly the bare form the analyser
      // matches: `uid() in resource.data.participants`. Wrapping it in
      // `.get(...)` or extra conditions defeats that, so it stays plain, with
      // the ID check as the fallback for any older document written without a
      // participants field.
      function inChatId() {
        return signedIn() && uid() in chatId.split('_');
      }
      function isParticipant() {
        return signedIn() && uid() in resource.data.participants;
      }

      // `participants` decides who may read the thread, and it was writable by
      // a participant to any value at all — so one party could add a third uid
      // and that outsider could then read the chat document, `lastMessage` and
      // participant names included. The doc id already names both parties;
      // the field may only restate it.
      function participantsMatchId() {
        return !('participants' in request.resource.data)
          || request.resource.data.participants.hasOnly(chatId.split('_'));
      }

      allow read: if isParticipant() || inChatId() || isAdmin();
      // Split, because `write` covers delete and `request.resource` is NULL on a
      // delete — participantsMatchId() dereferenced it and the whole rule
      // errored, so "delete conversation" started failing for everyone. Both
      // products swallow that rejection, so the thread vanished from the list
      // and came back on reload.
      allow create, update: if isAdmin() || (inChatId() && participantsMatchId());
      allow delete: if isAdmin() || inChatId();

      match /messages/{messageId} {
        // Messages are queried by orderBy(createdAt) with no field filter, so
        // membership must come from the chat ID here — there is nothing in the
        // query for a participants-based rule to match against.
        allow read: if inChatId() || isAdmin();
        // The text cap is the only bound there was: nothing stopped a message
        // of a megabyte, which the recipient's listener downloads every time
        // they open the thread. sendImageMessage caps its payload; text had
        // nothing. 4000 characters is far more than any real message.
        allow create: if inChatId()
          && request.resource.data.get('fromUid', '') == uid()
          && request.resource.data.get('text', '').size() <= 4000;
        allow update: if false;                 // messages are immutable
        // Your own message, not your counterparty's. Messages are immutable
        // above, so the intent is that a sent message is a record — but delete
        // was open to either participant, which destroys the evidence in
        // exactly the disputes /reports exists to settle.
        allow delete: if isAdmin()
          || (inChatId() && resource.data.get('fromUid', '') == uid());
      }
    }

    // ── Support messages ─────────────────────────────────────────────────────
    // A support thread is between one user and the team; other users have no
    // business reading it.
    match /supportMessages/{msgId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('uid', '') == uid());
      allow create: if signedIn()
        && request.resource.data.get('uid', '') == uid();
      allow update, delete: if isAdmin();
    }

    // ── Urgent requests ──────────────────────────────────────────────────────
    // Broadcast to every cleaner by design, so reads stay open. Only the client
    // who posted it (or the assigned cleaner / admin) may remove it.
    match /urgentRequests/{reqId} {
      function urgentOwner() {
        return signedIn() && resource.data.get('clientUid', '') == uid();
      }
      // The claiming cleaner, under either spelling — the app has always written
      // `takenByUid` and the web `takenBy`, and both are written now.
      function urgentHolder() {
        return signedIn() && (
          resource.data.get('takenByUid', '') == uid()
          || resource.data.get('takenBy', '') == uid()
        );
      }
      // Ownership is not transferable. Without this, an attacker wrote their own
      // uid into `clientUid` and the delete rule below then believed them.
      function urgentOwnerUnchanged() {
        return request.resource.data.get('clientUid', '')
            == resource.data.get('clientUid', '');
      }
      // The fields a claim or a release is allowed to touch, and no others.
      function onlyClaimFields() {
        return changed().hasOnly([
          'status', 'takenBy', 'takenByUid', 'takenByName', 'takenAt', 'expiresAt'
        ]);
      }

      // Open requests are a broadcast; everything else is not.
      //
      // This was `allow read: if signedIn()` with no filter on status, so every
      // cancelled, expired and completed request stayed readable to every
      // account forever — and these documents carry `address`, a full street
      // address, alongside the client's name and the time their home is empty.
      // Broadcasting live work to cleaners is the point; retaining the archive
      // for anyone who ever signed up is not.
      //
      // Every query either product runs is `status == 'open'` or
      // `clientUid == me`, so nothing on any screen changes.
      allow read: if isAdmin()
        || urgentOwner()
        || urgentHolder()
        || (signedIn() && resource.data.get('status', '') == 'open');

      allow create: if signedIn()
        && request.resource.data.get('clientUid', '') == uid();

      // `allow update: if signedIn()` used to stand here, with the comment
      // "cleaners claim / clients edit" describing an intent the rule did not
      // express. It constrained neither who wrote, nor which fields, nor the
      // prior state, so any signed-in account could rewrite any request in the
      // system: claim one already held by a real cleaner, cancel every open
      // request on the board, change `total` (which acceptUrgentRequest copies
      // straight into the booking it creates), swap `address` so the cleaner is
      // dispatched somewhere else, or write their own `clientUid` and inherit
      // the request outright.
      allow update: if isAdmin()
        // The owner edits their own request — but cannot hand it to anyone else.
        || (urgentOwner() && urgentOwnerUnchanged())
        // A cleaner claims a request that is genuinely open, touching only the
        // claim fields, and may only claim it for themselves.
        || (signedIn() && callerIsCleaner() && urgentOwnerUnchanged() && onlyClaimFields()
            && resource.data.get('status', '') == 'open'
            && request.resource.data.get('status', '') == 'taken'
            // Both spellings, or the claim is lying under one of them: writing
            // takenByUid=me and takenBy=someone-else passed a check on either
            // field alone, and readers disagree about which one holds it.
            && request.resource.data.get('takenByUid', '') == uid()
            && request.resource.data.get('takenBy', '') == uid())
        // The cleaner holding it lets it go — back to the board when the slot is
        // still ahead, cancelled when it is not. Only 'open' was allowed here,
        // and releaseUrgentRequest writes 'cancelled' for a slot already past
        // (lib/urgentRelease.ts) — so a late cleaner cancellation was denied and
        // the request stayed `taken` forever, off every board and claimable by
        // nobody. That is the exact bug urgentRelease.ts exists to prevent.
        //
        // A holder may only put it BACK, never cancel it. Anyone can become the
        // holder by claiming, so "claim then cancel" was two legal writes that
        // emptied the whole board — the very abuse the single-write rule above
        // refuses. Cancelling belongs to the owner alone. A request whose slot
        // has passed is reopened rather than cancelled; isUrgentRequestLive
        // hides it from every board and its owner's sweep clears it.
        || (urgentHolder() && urgentOwnerUnchanged() && onlyClaimFields()
            && request.resource.data.get('status', '') == 'open');

      // `cleanerId` is listed for symmetry with the schema this collection was
      // modelled on, but no urgent request has ever carried it — a claiming
      // cleaner is `takenByUid`. In practice this is owner-or-admin only, and
      // both clients now filter their sweeps accordingly.
      allow delete: if isAdmin() || (signedIn() && (
        resource.data.get('clientUid', '') == uid()
        || resource.data.get('cleanerId', '') == uid()
      ));
    }

    // ── Reports (bug reports / reporting a user) ─────────────────────────────
    // Write-only for users: a reported party must not be able to read, edit or
    // quietly delete the report filed against them.
    // One document per phone number, holding the uid that owns it.
    //
    // Firestore has no unique index, so every "already taken" in this product
    // was a query — and the query that answered it (users where phone == x) can
    // return a client document, so the users list rule refuses it and the check
    // failed open on every call. It was dead code presenting as a control.
    //
    // A document keyed BY the number needs no listing at all: `create` succeeds
    // only when nothing is there, `update` is refused outright, so the first
    // writer keeps it and the second is denied by the database. Delete is the
    // owner's, so changing your number gives the old one back.
    match /phoneIndex/{phoneNumber} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.get('uid', '') == uid();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == uid());
    }

    // Staff notes about a user. Their own collection because the rules cannot
    // hide one FIELD of a document: users grants `get` to any signed-in account,
    // so a note kept there was readable by the person it was about — and the CRM
    // presents these beside blocked and at-risk segmentation.
    match /adminNotes/{userId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      // `reportedBy` had no validation, so a report could be filed under
      // somebody else's name — a way to make a user look like they were
      // harassing another. The collection is invisible to non-admins either
      // way, so this costs nothing and closes the frame-up.
      allow create: if signedIn()
        && request.resource.data.get('reportedBy', '') == uid()
        && request.resource.data.get('description', '').size() <= 4000
        && request.resource.data.get('target', '').size() <= 200;
      allow update, delete: if isAdmin();
    }

    // ── Insurance requests ───────────────────────────────────────────────────
    // The writer (smartclean3/app/profile.tsx) stores the submitter under
    // `clientUid`, matching the bookings schema — not `uid`.
    //
    // NOTE: nothing in either app currently READS this collection. A client can
    // file an insurance claim and no screen anywhere displays it. Worth an
    // admin tab; until then these rules at least keep the claims private.
    match /insuranceRequests/{reqId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('clientUid', '') == uid());
      allow create: if signedIn()
        && request.resource.data.get('clientUid', '') == uid();
      allow update, delete: if isAdmin();
    }

    // ── Promo codes ──────────────────────────────────────────────────────────
    match /promoCodes/{promoId} {
      // Every discount code in the product was readable by any signed-in
      // account. The only readers in either product are the admin screens
      // (app/admin.tsx, src/hooks/useAdminData.ts), so nothing else loses
      // anything. Redemption, if it is ever built, must not be a client-side
      // read of this collection for the same reason.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Admin settings ───────────────────────────────────────────────────────
    match /settings/{settingId} {
      // Nothing in either product reads or writes this collection. It was the
      // last unscoped `read: if signedIn()` left in the file.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Rate limiting (written by Cloud Functions via the Admin SDK) ─────────
    // The Admin SDK bypasses rules; clients must never touch these counters.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
