# Normalize line endings.
#
# Without this, a Windows checkout rewrites every file to CRLF and `git status`
# reports the whole tree as modified — which is exactly what was happening here:
# app/index.tsx showed 522 changed lines that were entirely invisible
# whitespace. Real changes drown in the noise, and diffing the two copies of
# firestore.rules reported every single line as different.
#
# `text=auto eol=lf` stores LF in the repository and checks out LF everywhere.
* text=auto eol=lf

# Binaries must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.m4a binary
*.mp3 binary
*.pdf binary
*.zip binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
